# Planner-centric mini setup: recommended default.
# Downloads the pieces needed for behavioral / trajectory / path planning:
#   - HD semantic maps
#   - mini SQLite log DBs containing ego state, agent tracks, traffic lights, route/mission metadata
# Does NOT download raw camera/LiDAR sensor blobs.
DOWNLOAD_MAPS=true
DOWNLOAD_MINI_DB=true
DOWNLOAD_MINI_CAMERA=false
DOWNLOAD_MINI_LIDAR=false
KEEP_ARCHIVES=false
MAX_ACTIVE_MINI_DBS=all
TRIM_MINI_DBS_AFTER_EXTRACT=false
TRIM_MODE=none