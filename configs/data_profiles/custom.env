# Edit this file for your own dataset selection.
# Set booleans to true/false. Use MAX_ACTIVE_MINI_DBS=all or an integer.
DOWNLOAD_MAPS=true
DOWNLOAD_MINI_DB=true
DOWNLOAD_MINI_CAMERA=false
DOWNLOAD_MINI_LIDAR=false
KEEP_ARCHIVES=true
MAX_ACTIVE_MINI_DBS=all
TRIM_MINI_DBS_AFTER_EXTRACT=false
# none    -> keep all DB files; create active subset metadata only
# disable -> move inactive DBs to splits/mini.disabled; saves no disk, but hides them from default mini scans
# delete  -> delete inactive DBs; saves disk, but requires re-unzipping to restore them
TRIM_MODE=none