# Same as planner_mini, but makes only a small number of mini DBs active for fast iteration.
# Note: the public mini DB bundle is downloaded as one zip, so this reduces the active working set,
# not the network transfer size of the official mini archive.
DOWNLOAD_MAPS=true
DOWNLOAD_MINI_DB=true
DOWNLOAD_MINI_CAMERA=false
DOWNLOAD_MINI_LIDAR=false
KEEP_ARCHIVES=false
MAX_ACTIVE_MINI_DBS=3
TRIM_MINI_DBS_AFTER_EXTRACT=false
TRIM_MODE=none